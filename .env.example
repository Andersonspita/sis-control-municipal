# Conexão do dono do banco: usada só pelo Prisma CLI (migrações) e pelos scripts de setup/seed.
DATABASE_URL="postgresql://postgres:TROCAR@localhost:5432/controladoria"

# Conexão da aplicação: papel sem BYPASSRLS, sujeito às políticas de isolamento por cliente.
APP_DB_USER="controladoria_app"
APP_DB_PASSWORD="TROCAR"
APP_DATABASE_URL="postgresql://controladoria_app:TROCAR@localhost:5432/controladoria"

# Banco local embutido (npm run db:local), usado quando o Docker não está disponível.
LOCAL_PG_PASSWORD="TROCAR"
LOCAL_PG_PORT="5432"

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Armazenamento de documentos: "s3" usa as variáveis S3_* (Silo/MinIO, path-style; o bucket é criado se não existir);
# "local" grava em STORAGE_LOCAL_DIR (padrão: ./storage, ignorada pelo git).
# Vazio = automático: S3 quando S3_ENDPOINT, S3_BUCKET, S3_ACCESS_KEY e S3_SECRET_KEY estão definidas; senão, local.
STORAGE_DRIVER=""
STORAGE_LOCAL_DIR=""
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="controladoria"
S3_ACCESS_KEY="controladoria"
S3_SECRET_KEY="TROCAR"

OPENAI_API_KEY=""
