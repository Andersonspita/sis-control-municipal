// Sistema de Controladoria Municipal — HorizonAJ
//
// Tabelas globais (sem RLS): clientes, usuarios, sessoes, vinculos_cliente, normas, requisitos.
// Demais tabelas carregam cliente_id e são isoladas por Row Level Security
// (ver prisma/migrations/*_rls). A aplicação conecta com um papel sem BYPASSRLS.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Organização e acesso ─────────────────────────

enum TipoCliente {
  PREFEITURA
  CAMARA
  AUTARQUIA
  FUNDACAO
  CONSORCIO
  EMPRESA_PUBLICA
  OUTRO
}

enum Perfil {
  CONTROLADOR
  EQUIPE
  SATELITE
}

enum TipoUnidade {
  ORGAO
  SECRETARIA
  DEPARTAMENTO
  DIVISAO
  SETOR
  OUTRO
}

model Cliente {
  id           String      @id @default(uuid(7)) @db.Uuid
  nome         String
  tipo         TipoCliente
  cnpj         String      @unique @db.VarChar(14)
  municipio    String
  uf           String      @db.Char(2)
  codigoIbge   String?     @map("codigo_ibge") @db.VarChar(7)
  populacao    Int?
  brasaoKey    String?     @map("brasao_key")
  /// Identidade visual escolhida pelo controlador (ver src/lib/temas.ts).
  tema         String      @default("mata") @db.VarChar(20)
  ativo        Boolean     @default(true)
  criadoEm     DateTime    @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime    @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  vinculos  VinculoCliente[]
  unidades  Unidade[]
  sessoes   Sessao[]
  ciclos    CicloAvaliacao[]
  respostas RespostaRequisito[]
  planos    PlanoAcao[]
  acoes     Acao[]
  demandas  Demanda[]
  tramites  TramitacaoDemanda[]
  documentos Documento[]
  escopos   EscopoSatelite[]
  situacoes Situacao[]
  planosAuditoria  PlanoAnualAuditoria[]
  auditorias       Auditoria[]
  modelosChecklist ModeloChecklist[]
  logs      LogAuditoria[]
  extracoesDocumento ExtracaoDocumento[]
  trechosDocumento   TrechoDocumento[]
  analisesIA         AnaliseIA[]
  sugestoesIA        SugestaoIA[]
  relatoriosAnuais RelatorioAnual[]

  @@map("clientes")
}

model Usuario {
  id            String    @id @default(uuid(7)) @db.Uuid
  nome          String
  email         String    @unique
  cpf           String?   @unique @db.VarChar(11)
  senhaHash     String    @map("senha_hash")
  adminHorizon  Boolean   @default(false) @map("admin_horizon")
  ativo         Boolean   @default(true)
  ultimoAcessoEm DateTime? @map("ultimo_acesso_em") @db.Timestamptz(3)
  criadoEm      DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm  DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  vinculos VinculoCliente[]
  sessoes  Sessao[]

  @@map("usuarios")
}

model Sessao {
  id             String   @id @db.VarChar(64)
  usuarioId      String   @map("usuario_id") @db.Uuid
  clienteAtivoId String?  @map("cliente_ativo_id") @db.Uuid
  expiraEm       DateTime @map("expira_em") @db.Timestamptz(3)
  ip             String?
  userAgent      String?  @map("user_agent")
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  clienteAtivo Cliente? @relation(fields: [clienteAtivoId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@map("sessoes")
}

model VinculoCliente {
  id        String   @id @default(uuid(7)) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  clienteId String   @map("cliente_id") @db.Uuid
  perfil    Perfil
  cargo     String?
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  usuario Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cliente Cliente          @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  escopos EscopoSatelite[]

  @@unique([usuarioId, clienteId])
  @@index([clienteId])
  @@map("vinculos_cliente")
}

model Unidade {
  id              String      @id @default(uuid(7)) @db.Uuid
  clienteId       String      @map("cliente_id") @db.Uuid
  paiId           String?     @map("pai_id") @db.Uuid
  nome            String
  sigla           String?
  tipo            TipoUnidade @default(SECRETARIA)
  responsavelNome String?     @map("responsavel_nome")
  responsavelEmail String?    @map("responsavel_email")
  ativo           Boolean     @default(true)
  criadoEm        DateTime    @default(now()) @map("criado_em") @db.Timestamptz(3)

  cliente  Cliente          @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  pai      Unidade?         @relation("Hierarquia", fields: [paiId], references: [id], onDelete: Restrict)
  filhas   Unidade[]        @relation("Hierarquia")
  escopos  EscopoSatelite[]
  demandas Demanda[]
  acoes    Acao[]
  ciclos   CicloAvaliacao[]
  situacoes Situacao[]
  itensPlanoAuditoria ItemPlanoAuditoria[]
  auditorias          Auditoria[]
  recomendacoes       Recomendacao[]

  @@index([clienteId])
  @@map("unidades")
}

// Unidades que um usuário satélite pode ver dentro do cliente.
model EscopoSatelite {
  id        String @id @default(uuid(7)) @db.Uuid
  clienteId String @map("cliente_id") @db.Uuid
  vinculoId String @map("vinculo_id") @db.Uuid
  unidadeId String @map("unidade_id") @db.Uuid

  cliente Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  vinculo VinculoCliente @relation(fields: [vinculoId], references: [id], onDelete: Cascade)
  unidade Unidade        @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  @@unique([vinculoId, unidadeId])
  @@index([clienteId])
  @@map("escopos_satelite")
}

// ───────────────────────── Normas (catálogo global) ─────────────────────────

model Norma {
  id             String    @id @default(uuid(7)) @db.Uuid
  codigo         String
  versao         String
  titulo         String
  orgaoEmissor   String    @map("orgao_emissor")
  dataPublicacao DateTime? @map("data_publicacao") @db.Date
  fonteUrl       String?   @map("fonte_url")
  descricao      String?
  ativo          Boolean   @default(true)
  importadoEm    DateTime  @default(now()) @map("importado_em") @db.Timestamptz(3)

  requisitos Requisito[]
  ciclos     CicloAvaliacao[]

  @@unique([codigo, versao])
  @@map("normas")
}

enum TipoRequisito {
  ESTRUTURAL
  PROCEDIMENTAL
  DOCUMENTAL
}

// As quatro macrofunções da OT 05/2024 (condição V; CONTROLADORIA = controle interno e estrutura do órgão)
// e as áreas de atuação controladas (Res. TCM-BA 1.120/2005, art. 12).
enum Macrofuncao {
  AUDITORIA_INTERNA
  CONTROLADORIA
  CORREGEDORIA
  OUVIDORIA
  PLANEJAMENTO_ORCAMENTO
  CONTABILIDADE_FINANCAS
  GESTAO_FISCAL
  RECEITA
  PESSOAL
  PATRIMONIO
  LICITACOES_CONTRATOS
  OBRAS
  TRANSFERENCIAS
  TRANSPARENCIA
}

model Requisito {
  id            String        @id @default(uuid(7)) @db.Uuid
  normaId       String        @map("norma_id") @db.Uuid
  paiId         String?       @map("pai_id") @db.Uuid
  codigo        String
  ordem         Int
  titulo        String
  descricao     String?
  orientacao    String?
  fundamento    String?
  avaliavel     Boolean       @default(true)
  tiposEntidade TipoCliente[] @map("tipos_entidade")
  tipo          TipoRequisito?
  /// Peso no cálculo de conformidade (1 a 10; CHECK no banco).
  peso          Int           @default(1)
  /// Vazio = transversal (não entra em nenhum grupo da conformidade por macrofunção).
  macrofuncoes  Macrofuncao[] @default([])
  periodicidade String?
  palavrasChave String[]      @default([]) @map("palavras_chave")

  norma     Norma               @relation(fields: [normaId], references: [id], onDelete: Cascade)
  pai       Requisito?          @relation("Arvore", fields: [paiId], references: [id], onDelete: Cascade)
  filhos    Requisito[]         @relation("Arvore")
  respostas RespostaRequisito[]

  @@unique([normaId, codigo])
  @@index([paiId])
  @@map("requisitos")
}

// ───────────────────────── Autoavaliação ─────────────────────────

enum StatusCiclo {
  EM_ANDAMENTO
  CONCLUIDO
  ARQUIVADO
}

enum SituacaoRequisito {
  NAO_AVALIADO
  ATENDIDO
  PARCIALMENTE_ATENDIDO
  NAO_ATENDIDO
  NAO_APLICAVEL
}

model CicloAvaliacao {
  id          String      @id @default(uuid(7)) @db.Uuid
  clienteId   String      @map("cliente_id") @db.Uuid
  normaId     String      @map("norma_id") @db.Uuid
  unidadeId   String?     @map("unidade_id") @db.Uuid
  nome        String
  dataInicio  DateTime    @map("data_inicio") @db.Date
  dataFim     DateTime?   @map("data_fim") @db.Date
  status      StatusCiclo @default(EM_ANDAMENTO)
  criadoPorId String      @map("criado_por_id") @db.Uuid
  criadoEm    DateTime    @default(now()) @map("criado_em") @db.Timestamptz(3)
  /// Ao concluir, as respostas ficam congeladas (trigger em respostas_requisito).
  concluidoEm    DateTime? @map("concluido_em") @db.Timestamptz(3)
  concluidoPorId String?   @map("concluido_por_id") @db.Uuid

  cliente   Cliente             @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  norma     Norma               @relation(fields: [normaId], references: [id], onDelete: Restrict)
  unidade   Unidade?            @relation(fields: [unidadeId], references: [id], onDelete: SetNull)
  respostas RespostaRequisito[]
  planos    PlanoAcao[]

  @@index([clienteId])
  @@map("ciclos_avaliacao")
}

model RespostaRequisito {
  id              String            @id @default(uuid(7)) @db.Uuid
  clienteId       String            @map("cliente_id") @db.Uuid
  cicloId         String            @map("ciclo_id") @db.Uuid
  requisitoId     String            @map("requisito_id") @db.Uuid
  situacao        SituacaoRequisito @default(NAO_AVALIADO)
  observacao      String?
  evidencia       String?
  respondidoPorId String?           @map("respondido_por_id") @db.Uuid
  respondidoEm    DateTime?         @map("respondido_em") @db.Timestamptz(3)

  cliente    Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  ciclo      CicloAvaliacao @relation(fields: [cicloId], references: [id], onDelete: Cascade)
  requisito  Requisito      @relation(fields: [requisitoId], references: [id], onDelete: Restrict)
  acoes      Acao[]
  documentos Documento[]
  demandas   Demanda[]
  sugestoesIA SugestaoIA[]

  @@unique([cicloId, requisitoId])
  @@index([clienteId])
  @@map("respostas_requisito")
}

// ───────────────────────── Plano de ação (5W2H) ─────────────────────────

enum OrigemPlano {
  REQUISITO
  AUDITORIA
  MEDIDA
  DETERMINACAO_TC
  OUTRA
}

enum StatusPlano {
  RASCUNHO
  EM_EXECUCAO
  CONCLUIDO
  CANCELADO
}

enum StatusAcao {
  PENDENTE
  EM_ANDAMENTO
  AGUARDANDO_VALIDACAO
  CONCLUIDA
  CANCELADA
}

model PlanoAcao {
  id          String      @id @default(uuid(7)) @db.Uuid
  clienteId   String      @map("cliente_id") @db.Uuid
  cicloId     String?     @map("ciclo_id") @db.Uuid
  /// Situação (Medidas) que originou o plano; no máximo um plano por situação.
  situacaoId  String?     @unique @map("situacao_id") @db.Uuid
  /// Auditoria que originou o plano (recomendações viram ações); no máximo um plano por auditoria.
  auditoriaId String?     @unique @map("auditoria_id") @db.Uuid
  titulo      String
  descricao   String?
  origem      OrigemPlano
  status      StatusPlano @default(RASCUNHO)
  criadoPorId String      @map("criado_por_id") @db.Uuid
  criadoEm    DateTime    @default(now()) @map("criado_em") @db.Timestamptz(3)

  cliente Cliente         @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  ciclo   CicloAvaliacao? @relation(fields: [cicloId], references: [id], onDelete: SetNull)
  situacao Situacao?      @relation(fields: [situacaoId], references: [id], onDelete: SetNull)
  auditoria Auditoria?    @relation(fields: [auditoriaId], references: [id], onDelete: SetNull)
  acoes   Acao[]

  @@index([clienteId])
  @@map("planos_acao")
}

model Acao {
  id                   String     @id @default(uuid(7)) @db.Uuid
  clienteId            String     @map("cliente_id") @db.Uuid
  planoId              String     @map("plano_id") @db.Uuid
  respostaRequisitoId  String?    @map("resposta_requisito_id") @db.Uuid
  /// Recomendação de auditoria que originou a ação (no máximo uma ação por recomendação).
  recomendacaoId       String?    @unique @map("recomendacao_id") @db.Uuid
  unidadeResponsavelId String?    @map("unidade_responsavel_id") @db.Uuid
  oQue                 String     @map("o_que")
  porQue               String?    @map("por_que")
  onde                 String?
  prazo                DateTime?  @db.Date
  responsavel          String?
  como                 String?
  custoEstimado        Decimal?   @map("custo_estimado") @db.Decimal(14, 2)
  status               StatusAcao @default(PENDENTE)
  prioridade           Prioridade @default(MEDIA)
  percentual           Int        @default(0)
  validadoPorId        String?    @map("validado_por_id") @db.Uuid
  validadoEm           DateTime?  @map("validado_em") @db.Timestamptz(3)
  parecerValidacao     String?    @map("parecer_validacao")
  criadoEm             DateTime   @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm         DateTime   @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  cliente            Cliente            @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  plano              PlanoAcao          @relation(fields: [planoId], references: [id], onDelete: Cascade)
  respostaRequisito  RespostaRequisito? @relation(fields: [respostaRequisitoId], references: [id], onDelete: SetNull)
  unidadeResponsavel Unidade?           @relation(fields: [unidadeResponsavelId], references: [id], onDelete: SetNull)
  demandas           Demanda[]
  documentos         Documento[]
  marcos             MarcoAcao[]
  recomendacao       Recomendacao?      @relation(fields: [recomendacaoId], references: [id], onDelete: SetNull)

  @@index([clienteId])
  @@index([planoId])
  @@map("acoes")
}

// Etapas intermediárias de uma ação. cliente_id sem FK própria: a integridade vem da ação (RLS isola).
model MarcoAcao {
  id          String    @id @default(uuid(7)) @db.Uuid
  clienteId   String    @map("cliente_id") @db.Uuid
  acaoId      String    @map("acao_id") @db.Uuid
  descricao   String
  prazo       DateTime? @db.Date
  concluidoEm DateTime? @map("concluido_em") @db.Timestamptz(3)
  ordem       Int       @default(0)
  criadoEm    DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)

  acao Acao @relation(fields: [acaoId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@index([acaoId])
  @@map("marcos_acao")
}

// ───────────────────────── Demandas e tramitação ─────────────────────────

enum StatusDemanda {
  ENVIADA
  VISUALIZADA
  RESPONDIDA
  EM_ANALISE
  DEVOLVIDA
  CONCLUIDA
  CANCELADA
}

enum Prioridade {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum TipoTramite {
  ENVIO
  VISUALIZACAO
  RESPOSTA
  ANALISE
  DEVOLUCAO
  CONCLUSAO
  CANCELAMENTO
  PRORROGACAO_SOLICITADA
  PRORROGACAO_DEFERIDA
  PRORROGACAO_INDEFERIDA
  COMENTARIO
}

model Demanda {
  id               String        @id @default(uuid(7)) @db.Uuid
  clienteId        String        @map("cliente_id") @db.Uuid
  numero           Int
  ano              Int
  assunto          String
  descricao        String
  unidadeDestinoId String        @map("unidade_destino_id") @db.Uuid
  acaoId           String?       @map("acao_id") @db.Uuid
  /// Requisito da autoavaliação que originou a demanda; a resposta aceita vira evidência dele.
  respostaRequisitoId String?    @map("resposta_requisito_id") @db.Uuid
  /// Solicitação de auditoria: a auditoria que a originou (o satélite não lê a auditoria, só a demanda).
  auditoriaId      String?       @map("auditoria_id") @db.Uuid
  prazo            DateTime      @db.Date
  prioridade       Prioridade    @default(MEDIA)
  status           StatusDemanda @default(ENVIADA)
  criadoPorId      String        @map("criado_por_id") @db.Uuid
  criadoEm         DateTime      @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm     DateTime      @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  cliente        Cliente             @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  unidadeDestino Unidade             @relation(fields: [unidadeDestinoId], references: [id], onDelete: Restrict)
  acao           Acao?               @relation(fields: [acaoId], references: [id], onDelete: SetNull)
  respostaRequisito RespostaRequisito? @relation(fields: [respostaRequisitoId], references: [id], onDelete: SetNull)
  auditoria      Auditoria?          @relation(fields: [auditoriaId], references: [id], onDelete: SetNull)
  tramites       TramitacaoDemanda[]
  documentos     Documento[]

  @@unique([clienteId, ano, numero])
  @@index([clienteId, status])
  @@index([unidadeDestinoId])
  @@index([respostaRequisitoId])
  @@index([acaoId])
  @@index([auditoriaId])
  @@map("demandas")
}

// Histórico imutável: UPDATE e DELETE bloqueados por trigger.
model TramitacaoDemanda {
  id             String         @id @default(uuid(7)) @db.Uuid
  clienteId      String         @map("cliente_id") @db.Uuid
  demandaId      String         @map("demanda_id") @db.Uuid
  tipo           TipoTramite
  statusAnterior StatusDemanda? @map("status_anterior")
  statusNovo     StatusDemanda? @map("status_novo")
  texto          String?
  novoPrazo      DateTime?      @map("novo_prazo") @db.Date
  /// Comentário interno da controladoria: nunca visível ao satélite (RLS).
  interno        Boolean        @default(false)
  usuarioId      String         @map("usuario_id") @db.Uuid
  usuarioNome    String         @map("usuario_nome")
  criadoEm       DateTime       @default(now()) @map("criado_em") @db.Timestamptz(3)

  cliente    Cliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  demanda    Demanda     @relation(fields: [demandaId], references: [id], onDelete: Cascade)
  documentos Documento[]

  @@index([demandaId])
  @@index([clienteId])
  @@map("tramitacoes_demanda")
}

// ───────────────────────── Medidas ─────────────────────────

enum OrigemSituacao {
  CONSTATACAO
  DENUNCIA
  ALERTA
  ANALISE_IA
  DEMANDA_EXTERNA
}

enum StatusSituacao {
  ABERTA
  EM_TRATAMENTO
  RESOLVIDA
  ARQUIVADA
}

// Situação que precisa de intervenção, fora da conformidade normativa. Nunca visível ao satélite (RLS).
model Situacao {
  id                       String         @id @default(uuid(7)) @db.Uuid
  clienteId                String         @map("cliente_id") @db.Uuid
  numero                   Int
  ano                      Int
  titulo                   String
  descricao                String
  origem                   OrigemSituacao
  unidadeId                String?        @map("unidade_id") @db.Uuid
  /// 1 a 5 (CHECK no banco); gravidade = probabilidade × impacto (ver src/lib/risco.ts).
  probabilidade            Int
  impacto                  Int
  status                   StatusSituacao @default(ABERTA)
  /// Só para denúncia: quando sigilosa, o denunciante fica oculto a quem não é controlador.
  sigilosa                 Boolean        @default(false)
  denunciante              String?
  criadoPorId              String         @map("criado_por_id") @db.Uuid
  criadoEm                 DateTime       @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm             DateTime       @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  encerradoPorId           String?        @map("encerrado_por_id") @db.Uuid
  encerradoEm              DateTime?      @map("encerrado_em") @db.Timestamptz(3)
  justificativaEncerramento String?       @map("justificativa_encerramento")

  cliente    Cliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  unidade    Unidade?    @relation(fields: [unidadeId], references: [id], onDelete: SetNull)
  plano      PlanoAcao?
  documentos Documento[]

  @@unique([clienteId, ano, numero])
  @@index([clienteId, status])
  @@index([unidadeId])
  @@map("situacoes")
}

// ───────────────────────── Auditorias ─────────────────────────
// Papéis de trabalho: nunca visíveis ao satélite (RLS). Ele só recebe as solicitações, que são demandas.

enum TipoAuditoria {
  CONFORMIDADE
  OPERACIONAL
  FINANCEIRA
  GESTAO
  ESPECIAL
}

enum StatusPlanoAuditoria {
  RASCUNHO
  APROVADO
}

/// Transições validadas no banco (auditoria_transicao_valida) e em src/lib/auditorias.ts.
enum StatusAuditoria {
  PLANEJAMENTO
  EXECUCAO
  RELATORIO_PRELIMINAR
  MANIFESTACAO
  RELATORIO_FINAL
  MONITORAMENTO
  ENCERRADA
  CANCELADA
}

enum ResultadoItemChecklist {
  CONFORME
  NAO_CONFORME
  PARCIAL
  NAO_APLICAVEL
}

/// Plano Anual de Auditoria Interna (PAAI): um por cliente e ano.
model PlanoAnualAuditoria {
  id            String               @id @default(uuid(7)) @db.Uuid
  clienteId     String               @map("cliente_id") @db.Uuid
  ano           Int
  status        StatusPlanoAuditoria @default(RASCUNHO)
  observacoes   String?
  criadoPorId   String               @map("criado_por_id") @db.Uuid
  criadoEm      DateTime             @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm  DateTime             @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  aprovadoPorId String?              @map("aprovado_por_id") @db.Uuid
  aprovadoEm    DateTime?            @map("aprovado_em") @db.Timestamptz(3)

  cliente Cliente              @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  itens   ItemPlanoAuditoria[]

  @@unique([clienteId, ano])
  @@map("planos_anuais_auditoria")
}

/// Auditoria prevista no PAAI. cliente_id sem FK própria: a integridade vem do plano (RLS isola).
model ItemPlanoAuditoria {
  id            String        @id @default(uuid(7)) @db.Uuid
  clienteId     String        @map("cliente_id") @db.Uuid
  planoId       String        @map("plano_id") @db.Uuid
  titulo        String
  tipo          TipoAuditoria
  unidadeId     String?       @map("unidade_id") @db.Uuid
  objetivo      String?
  /// 1 a 5 (CHECK no banco); risco = probabilidade × impacto (ver src/lib/risco.ts).
  probabilidade Int
  impacto       Int
  /// Período previsto, em meses do ano (1 a 12).
  mesInicio     Int           @map("mes_inicio")
  mesFim        Int           @map("mes_fim")
  criadoEm      DateTime      @default(now()) @map("criado_em") @db.Timestamptz(3)

  plano     PlanoAnualAuditoria @relation(fields: [planoId], references: [id], onDelete: Cascade)
  unidade   Unidade?            @relation(fields: [unidadeId], references: [id], onDelete: SetNull)
  auditoria Auditoria?

  @@index([clienteId])
  @@index([planoId])
  @@map("itens_plano_auditoria")
}

model Auditoria {
  id                        String          @id @default(uuid(7)) @db.Uuid
  clienteId                 String          @map("cliente_id") @db.Uuid
  numero                    Int
  ano                       Int
  titulo                    String
  tipo                      TipoAuditoria
  objetivo                  String
  escopo                    String?
  /// Alcance: nulo = a entidade inteira; preenchido = só a unidade.
  unidadeId                 String?         @map("unidade_id") @db.Uuid
  criterios                 String?
  /// Usuários da controladoria (Controlador ou Equipe) que compõem a equipe.
  equipeIds                 String[]        @default([]) @map("equipe_ids") @db.Uuid
  itemPlanoId               String?         @unique @map("item_plano_id") @db.Uuid
  inicioPrevisto            DateTime?       @map("inicio_previsto") @db.Date
  fimPrevisto               DateTime?       @map("fim_previsto") @db.Date
  status                    StatusAuditoria @default(PLANEJAMENTO)
  justificativaCancelamento String?         @map("justificativa_cancelamento")
  criadoPorId               String          @map("criado_por_id") @db.Uuid
  criadoEm                  DateTime        @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm              DateTime        @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  cliente    Cliente              @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  unidade    Unidade?             @relation(fields: [unidadeId], references: [id], onDelete: SetNull)
  itemPlano  ItemPlanoAuditoria?  @relation(fields: [itemPlanoId], references: [id], onDelete: SetNull)
  questoes   QuestaoAuditoria[]
  checklists ChecklistAuditoria[]
  achados    Achado[]
  plano      PlanoAcao?
  demandas   Demanda[]
  documentos Documento[]

  @@unique([clienteId, ano, numero])
  @@index([clienteId, status])
  @@index([unidadeId])
  @@map("auditorias")
}

/// Matriz de planejamento: uma linha por questão de auditoria.
model QuestaoAuditoria {
  id            String   @id @default(uuid(7)) @db.Uuid
  clienteId     String   @map("cliente_id") @db.Uuid
  auditoriaId   String   @map("auditoria_id") @db.Uuid
  ordem         Int      @default(0)
  questao       String
  informacoes   String?
  fontes        String?
  procedimentos String?
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  auditoria Auditoria @relation(fields: [auditoriaId], references: [id], onDelete: Cascade)

  @@index([auditoriaId])
  @@map("questoes_auditoria")
}

/// Modelo reutilizável de checklist, por cliente.
model ModeloChecklist {
  id           String         @id @default(uuid(7)) @db.Uuid
  clienteId    String         @map("cliente_id") @db.Uuid
  nome         String
  descricao    String?
  tipo         TipoAuditoria?
  ativo        Boolean        @default(true)
  criadoEm     DateTime       @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime       @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  cliente    Cliente              @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  itens      ItemChecklist[]
  aplicacoes ChecklistAuditoria[]

  @@unique([clienteId, nome])
  @@map("modelos_checklist")
}

model ItemChecklist {
  id         String  @id @default(uuid(7)) @db.Uuid
  clienteId  String  @map("cliente_id") @db.Uuid
  modeloId   String  @map("modelo_id") @db.Uuid
  ordem      Int     @default(0)
  texto      String
  orientacao String?

  modelo ModeloChecklist @relation(fields: [modeloId], references: [id], onDelete: Cascade)

  @@index([modeloId])
  @@map("itens_checklist")
}

/// Modelo aplicado a uma auditoria: os itens são copiados (auditoria_aplicar_checklist) e avaliados na execução.
model ChecklistAuditoria {
  id          String   @id @default(uuid(7)) @db.Uuid
  clienteId   String   @map("cliente_id") @db.Uuid
  auditoriaId String   @map("auditoria_id") @db.Uuid
  modeloId    String?  @map("modelo_id") @db.Uuid
  nome        String
  criadoPorId String   @map("criado_por_id") @db.Uuid
  criadoEm    DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  auditoria Auditoria                @relation(fields: [auditoriaId], references: [id], onDelete: Cascade)
  modelo    ModeloChecklist?         @relation(fields: [modeloId], references: [id], onDelete: SetNull)
  itens     ItemChecklistAuditoria[]

  @@unique([auditoriaId, modeloId])
  @@index([clienteId])
  @@map("checklists_auditoria")
}

model ItemChecklistAuditoria {
  id            String                  @id @default(uuid(7)) @db.Uuid
  clienteId     String                  @map("cliente_id") @db.Uuid
  checklistId   String                  @map("checklist_id") @db.Uuid
  ordem         Int                     @default(0)
  texto         String
  orientacao    String?
  resultado     ResultadoItemChecklist?
  observacao    String?
  avaliadoPorId String?                 @map("avaliado_por_id") @db.Uuid
  avaliadoEm    DateTime?               @map("avaliado_em") @db.Timestamptz(3)

  checklist  ChecklistAuditoria @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  achados    Achado[]
  documentos Documento[]

  @@index([checklistId])
  @@map("itens_checklist_auditoria")
}

/// Achado no padrão do TCU: condição, critério, causa e efeito; gravidade = probabilidade × impacto.
model Achado {
  id              String   @id @default(uuid(7)) @db.Uuid
  clienteId       String   @map("cliente_id") @db.Uuid
  auditoriaId     String   @map("auditoria_id") @db.Uuid
  numero          Int
  titulo          String
  condicao        String
  criterio        String
  causa           String
  efeito          String
  probabilidade   Int
  impacto         Int
  itemChecklistId String?  @map("item_checklist_id") @db.Uuid
  criadoPorId     String   @map("criado_por_id") @db.Uuid
  criadoEm        DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm    DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  auditoria     Auditoria               @relation(fields: [auditoriaId], references: [id], onDelete: Cascade)
  itemChecklist ItemChecklistAuditoria? @relation(fields: [itemChecklistId], references: [id], onDelete: SetNull)
  recomendacoes Recomendacao[]
  documentos    Documento[]

  @@unique([auditoriaId, numero])
  @@index([clienteId])
  @@map("achados")
}

/// Recomendação de um achado; pode virar ação no plano da auditoria (recomendacao_gerar_acao).
model Recomendacao {
  id          String    @id @default(uuid(7)) @db.Uuid
  clienteId   String    @map("cliente_id") @db.Uuid
  achadoId    String    @map("achado_id") @db.Uuid
  numero      Int
  texto       String
  unidadeId   String?   @map("unidade_id") @db.Uuid
  prazo       DateTime? @db.Date
  criadoPorId String    @map("criado_por_id") @db.Uuid
  criadoEm    DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)

  achado  Achado   @relation(fields: [achadoId], references: [id], onDelete: Cascade)
  unidade Unidade? @relation(fields: [unidadeId], references: [id], onDelete: SetNull)
  acao    Acao?

  @@unique([achadoId, numero])
  @@index([clienteId])
  @@map("recomendacoes")
}

// ───────────────────────── Documentos ─────────────────────────

model Documento {
  id                  String   @id @default(uuid(7)) @db.Uuid
  clienteId           String   @map("cliente_id") @db.Uuid
  nome                String
  mimeType            String   @map("mime_type")
  tamanho             Int
  sha256              String   @db.Char(64)
  storageKey          String   @unique @map("storage_key")
  enviadoPorId        String   @map("enviado_por_id") @db.Uuid
  demandaId           String?  @map("demanda_id") @db.Uuid
  tramiteId           String?  @map("tramite_id") @db.Uuid
  respostaRequisitoId String?  @map("resposta_requisito_id") @db.Uuid
  acaoId              String?  @map("acao_id") @db.Uuid
  situacaoId          String?  @map("situacao_id") @db.Uuid
  auditoriaId         String?  @map("auditoria_id") @db.Uuid
  itemAuditoriaId     String?  @map("item_auditoria_id") @db.Uuid
  achadoId            String?  @map("achado_id") @db.Uuid
  criadoEm            DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  cliente           Cliente            @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  demanda           Demanda?           @relation(fields: [demandaId], references: [id], onDelete: SetNull)
  tramite           TramitacaoDemanda? @relation(fields: [tramiteId], references: [id], onDelete: SetNull)
  respostaRequisito RespostaRequisito? @relation(fields: [respostaRequisitoId], references: [id], onDelete: SetNull)
  acao              Acao?              @relation(fields: [acaoId], references: [id], onDelete: SetNull)
  situacao          Situacao?          @relation(fields: [situacaoId], references: [id], onDelete: SetNull)
  auditoria         Auditoria?         @relation(fields: [auditoriaId], references: [id], onDelete: SetNull)
  itemAuditoria     ItemChecklistAuditoria? @relation(fields: [itemAuditoriaId], references: [id], onDelete: SetNull)
  achado            Achado?            @relation(fields: [achadoId], references: [id], onDelete: SetNull)
  extracao          ExtracaoDocumento?
  trechos           TrechoDocumento[]

  @@index([clienteId])
  @@index([demandaId])
  @@index([tramiteId])
  @@index([situacaoId])
  @@index([auditoriaId])
  @@index([itemAuditoriaId])
  @@index([achadoId])
  @@map("documentos")
}

// ───────────────────────── Trilha de auditoria ─────────────────────────

// Somente inserção: UPDATE e DELETE bloqueados por trigger.
model LogAuditoria {
  id         BigInt   @id @default(autoincrement())
  clienteId  String?  @map("cliente_id") @db.Uuid
  usuarioId  String?  @map("usuario_id") @db.Uuid
  acao       String
  entidade   String?
  entidadeId String?  @map("entidade_id")
  dados      Json?
  ip         String?
  criadoEm   DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  @@index([clienteId, criadoEm])
  @@map("log_auditoria")
}

/// Configuração global da IA, em linha única (id = 1). As chaves de API ficam cifradas
/// com AES-256-GCM (ver src/lib/cripto.ts); só os 4 últimos caracteres ficam em claro, para exibição.
/// provedor: OPENAI, ANTHROPIC, GOOGLE ou OPENAI_COMPATIVEL (CHECK na migração; ver src/lib/ia/config.ts).
/// Embeddings: provedorEmbeddings nulo = mesmo provedor e chave do texto (a Anthropic não oferece embeddings).
model ConfiguracaoIA {
  id                     Int      @id @default(1) @db.SmallInt
  habilitada             Boolean  @default(false)
  provedor               String   @default("OPENAI") @db.VarChar(30)
  urlBase                String?  @map("url_base") @db.VarChar(300)
  chaveCifrada           String?  @map("chave_cifrada")
  chaveFinal             String?  @map("chave_final") @db.VarChar(4)
  modeloTexto            String   @default("gpt-4.1-mini") @map("modelo_texto") @db.VarChar(100)
  modeloEmbeddings       String   @default("text-embedding-3-small") @map("modelo_embeddings") @db.VarChar(100)
  provedorEmbeddings     String?  @map("provedor_embeddings") @db.VarChar(30)
  urlBaseEmbeddings      String?  @map("url_base_embeddings") @db.VarChar(300)
  chaveEmbeddingsCifrada String?  @map("chave_embeddings_cifrada")
  chaveEmbeddingsFinal   String?  @map("chave_embeddings_final") @db.VarChar(4)
  limiteMensalUsd        Decimal? @map("limite_mensal_usd") @db.Decimal(12, 2)
  alteradoPorId          String?  @map("alterado_por_id") @db.Uuid
  atualizadoEm           DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  @@map("configuracoes_ia")
}

// ───────────────────────── Relatórios ─────────────────────────

/// Relatório Anual de Controle Interno (art. 17 da Res. TCM-BA 1.120/2005): textos do controlador por cliente e ano.
/// As seções numéricas são montadas na emissão (src/lib/relatorios/anual.ts). Nunca visível ao satélite (RLS).
model RelatorioAnual {
  id              String    @id @default(uuid(7)) @db.Uuid
  clienteId       String    @map("cliente_id") @db.Uuid
  ano             Int
  /// Textos por seção (chaves em src/lib/relatorios/anual-secoes.ts).
  secoes          Json      @default("{}")
  atualizadoPorId String?   @map("atualizado_por_id") @db.Uuid
  criadoEm        DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  emitidoEm       DateTime? @map("emitido_em") @db.Timestamptz(3)

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, ano])
  @@map("relatorios_anuais")
}

// ───────────────────────── IA: análise de documentos ─────────────────────────
// Uso exclusivo da controladoria (o satélite não vê nem aciona: RLS restritiva). Toda sugestão
// fica pendente de revisão até o controlador aceitar, editar ou rejeitar (src/lib/ia/revisao.ts).

enum StatusExtracao {
  PENDENTE
  PROCESSANDO
  CONCLUIDA
  SEM_TEXTO
  ERRO
}

enum TipoAnaliseIA {
  COMPARAR_NORMA
  AVALIAR_EVIDENCIA
}

enum StatusAnaliseIA {
  PENDENTE
  PROCESSANDO
  CONCLUIDO
  ERRO
}

enum StatusSugestaoIA {
  PENDENTE_REVISAO
  ACEITA
  EDITADA
  REJEITADA
}

/// Texto extraído de um documento. Só o texto com dados pessoais mascarados é guardado (nos trechos) e enviado à OpenAI.
model ExtracaoDocumento {
  id               String         @id @default(uuid(7)) @db.Uuid
  clienteId        String         @map("cliente_id") @db.Uuid
  documentoId      String         @unique @map("documento_id") @db.Uuid
  status           StatusExtracao @default(PENDENTE)
  paginas          Int?
  caracteres       Int?
  /// Quantidade de dados pessoais mascarados, por tipo (cpf, email, telefone...).
  mascaramentos    Json?
  modeloEmbeddings String?        @map("modelo_embeddings") @db.VarChar(100)
  tokens           Int            @default(0)
  erro             String?
  criadoEm         DateTime       @default(now()) @map("criado_em") @db.Timestamptz(3)
  processadoEm     DateTime?      @map("processado_em") @db.Timestamptz(3)

  cliente   Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  documento Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@map("extracoes_documento")
}

/// Trecho do texto mascarado com o embedding (pgvector). Gravado e consultado por SQL bruto (src/lib/ia/documento.ts).
model TrechoDocumento {
  id          String                       @id @default(uuid(7)) @db.Uuid
  clienteId   String                       @map("cliente_id") @db.Uuid
  documentoId String                       @map("documento_id") @db.Uuid
  ordem       Int
  /// Página de origem; nulo quando o formato não tem paginação (DOCX, TXT sem quebra de página).
  pagina      Int?
  /// Posição (em caracteres) do início do trecho no texto da página.
  posicao     Int
  texto       String
  embedding   Unsupported("vector(1536)")?

  cliente   Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  documento Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  @@unique([documentoId, ordem])
  @@index([clienteId])
  @@map("trechos_documento")
}

/// Pedido de análise (fila no banco: PENDENTE → PROCESSANDO → CONCLUIDO/ERRO), com modelo, tokens e custo.
model AnaliseIA {
  id                  String          @id @default(uuid(7)) @db.Uuid
  clienteId           String          @map("cliente_id") @db.Uuid
  tipo                TipoAnaliseIA
  status              StatusAnaliseIA @default(PENDENTE)
  solicitadoPorId     String          @map("solicitado_por_id") @db.Uuid
  documentoIds        String[]        @map("documento_ids") @db.Uuid
  /// Referências sem chave estrangeira (a análise sobrevive como registro de custo).
  cicloId             String?         @map("ciclo_id") @db.Uuid
  respostaRequisitoId String?         @map("resposta_requisito_id") @db.Uuid
  provedor            String          @db.VarChar(20)
  modelo              String?         @db.VarChar(100)
  modeloEmbeddings    String?         @map("modelo_embeddings") @db.VarChar(100)
  tokensEntrada       Int             @default(0) @map("tokens_entrada")
  tokensSaida         Int             @default(0) @map("tokens_saida")
  tokensEmbeddings    Int             @default(0) @map("tokens_embeddings")
  custoUsd            Decimal         @default(0) @map("custo_usd") @db.Decimal(12, 6)
  /// Resumo do resultado: requisitos analisados, sugestões criadas, citações descartadas.
  resumo              Json?
  erro                String?
  criadoEm            DateTime        @default(now()) @map("criado_em") @db.Timestamptz(3)
  iniciadoEm          DateTime?       @map("iniciado_em") @db.Timestamptz(3)
  concluidoEm         DateTime?       @map("concluido_em") @db.Timestamptz(3)

  cliente   Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  sugestoes SugestaoIA[]

  @@index([clienteId, criadoEm])
  @@index([cicloId])
  @@map("analises_ia")
}

model SugestaoIA {
  id                  String           @id @default(uuid(7)) @db.Uuid
  clienteId           String           @map("cliente_id") @db.Uuid
  analiseId           String           @map("analise_id") @db.Uuid
  respostaRequisitoId String?          @map("resposta_requisito_id") @db.Uuid
  status              StatusSugestaoIA @default(PENDENTE_REVISAO)
  /// Conteúdo sugerido ({ situacao, justificativa, evidencia, faltantes }), validado com zod.
  conteudo            Json
  /// O que foi aplicado de fato (o sugerido ou a versão editada pelo controlador).
  conteudoAplicado    Json?            @map("conteudo_aplicado")
  /// Citações conferidas no texto: [{ documentoId, documentoNome, trechoId, pagina, texto }].
  citacoes            Json
  citacoesDescartadas Int              @default(0) @map("citacoes_descartadas")
  revisadoPorId       String?          @map("revisado_por_id") @db.Uuid
  revisadoEm          DateTime?        @map("revisado_em") @db.Timestamptz(3)
  motivoRejeicao      String?          @map("motivo_rejeicao")
  criadoEm            DateTime         @default(now()) @map("criado_em") @db.Timestamptz(3)

  cliente           Cliente            @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  analise           AnaliseIA          @relation(fields: [analiseId], references: [id], onDelete: Cascade)
  respostaRequisito RespostaRequisito? @relation(fields: [respostaRequisitoId], references: [id], onDelete: Cascade)

  @@index([clienteId, status])
  @@index([analiseId])
  @@index([respostaRequisitoId])
  @@map("sugestoes_ia")
}
