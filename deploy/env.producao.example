# Copie para .env na raiz do projeto, na VPS, e preencha. Nunca versione o .env.
# Gere segredos com: openssl rand -hex 32   (use só letras e números nas senhas do banco: elas entram em URLs)

# Endereço público (HTTPS) usado nos links dos e-mails.
APP_URL="https://controladoria.seudominio.com.br"

# Porta e IP em que o app é publicado no host: é o destino do proxy reverso (painel/OpenResty/Nginx).
# Troque a porta se a 3010 já estiver ocupada. APP_IP: 127.0.0.1 (proxy no host ou com rede host),
# IP do gateway do Docker, ex. 172.17.0.1 (proxy em container sem rede host), ou 0.0.0.0 (acesso direto pelo IP).
APP_PORTA="3010"
APP_IP="127.0.0.1"

# Cookie de sessão só por HTTPS (padrão em produção). Use "false" apenas para acesso por HTTP, sem certificado.
# COOKIE_SEGURO="false"

# Só para o Caddy embutido (dc --profile caddy up -d), em VPS sem outro proxy nas portas 80/443:
# domínio (DNS tipo A apontando para a VPS) e e-mail do certificado. Com proxy próprio, deixe vazios.
DOMINIO="controladoria.seudominio.com.br"
EMAIL_ACME="ti@seudominio.com.br"

# Banco: senha do dono (migrações) e do papel da aplicação (sujeito ao isolamento por cliente).
PG_SENHA_DONO=""
APP_DB_USER="controladoria_app"
APP_DB_PASSWORD=""

# Sessões: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Chave mestra que cifra segredos no banco (ex.: chave da IA). 32 bytes em base64:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guarde uma cópia segura: perder ou trocar esta chave obriga a recadastrar a chave da IA.
CHAVE_CRIPTOGRAFIA=""

# Armazenamento de documentos (Silo, interno à VPS).
S3_REGION="us-east-1"
S3_BUCKET="controladoria"
S3_ACCESS_KEY="controladoria"
S3_SECRET_KEY=""

# E-mail (SMTP do provedor contratado: ex. Amazon SES, Brevo, Mailgun, Google Workspace).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
EMAIL_REMETENTE="Controladoria <nao-responda@seudominio.com.br>"

# IA: a chave é cadastrada pela tela /admin/ia (fica cifrada no banco). Este valor é só um fallback opcional.
OPENAI_API_KEY=""
IA_PROVEDOR=""
